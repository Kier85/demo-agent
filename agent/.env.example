# Copy to agent/.env (git-ignored). Only the providers you set are used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional model overrides (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-6.1-sol
# XAI_MODEL=grok-4.3

# Where the shop API lives when running the agent outside docker compose
SHOP_API_URL=http://localhost:8080
SHOP_API_TOKEN=local-api-token
SHOP_ADMIN_TOKEN=local-admin-token

# Kill switch: disable a provider when > 5% of eval tickets contain a wrong action
KILL_SWITCH_THRESHOLD=0.05
